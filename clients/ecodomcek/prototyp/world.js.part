<script>
(function(){
  // ---------------------------------------------------------------
  // EcoDomček — prechádzka domom (prototyp)
  // Jeden svet, kamera vedená scrollom. Blockout domu v Lúčine.
  // GSAP + ScrollTrigger = jediný motor. three renderuje, neanimuje.
  // ---------------------------------------------------------------
  var BEATS = [
    {name:'01 Exteriér', pos:[16,7,18],     tgt:[-0.5,3.2,0],  cut:[1,1,1],       sun:'morning'},
    {name:'02 Fasáda',   pos:[6.5,2.6,12.5],tgt:[-2.5,3.8,0],  cut:[1,1,1],       sun:'morning'},
    {name:'03 Prah',     pos:[2.4,1.75,8.6],tgt:[1.0,2.1,3.0], cut:[.35,1,1],     sun:'day'},
    {name:'04 Obývačka', pos:[-2.0,1.62,2.3], tgt:[-6.3,1.05,-1.3],cut:[0,0,1],   sun:'day'},
    {name:'05 Stena',    pos:[-9.2,2.5,13.2],tgt:[-13.3,1.3,8.3],cut:[.08,.08,.16],sun:'day'},
    {name:'06 Kuchyňa',  pos:[0.9,1.65,0.4], tgt:[4.4,1.15,-2.8],cut:[0,0,1],     sun:'day'},
    {name:'07 Terasa',   pos:[1.2,2.0,9.6], tgt:[8.2,1.0,5.4], cut:[.5,1,1],      sun:'day'},
    {name:'08 Zhora',    pos:[12.5,9.5,13],  tgt:[-1.2,1.8,0],  cut:[.3,.04,.88], sun:'day'},
    {name:'09 Večer',    pos:[12.5,3.6,16], tgt:[-0.5,3.0,0],  cut:[1,1,1],       sun:'dusk'}
  ];
  var SUN = {
    morning:{col:0xffe8c8, int:2.0, pos:[-18,11,15], amb:0xefe7d6, ambInt:.7,  bg:0xf3eee3},
    day:    {col:0xfff6e8, int:2.2, pos:[12,19,13],  amb:0xf3eee3, ambInt:.9,  bg:0xf3eee3},
    dusk:   {col:0xf2b563, int:.45, pos:[-22,3.5,-8],amb:0x2b2723, ambInt:.3,  bg:0x1d1b19}
  };

  var reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  var mobile = innerWidth < 861;
  var renderer, scene, camera, sun, amb, hemi;
  var cutMeshes = {front:[], roof:[], other:[]};
  var glassPanes = [], winGlow = [], layerMeshes = [], roomLights = [], firelight;
  var ready = false;

  function mat(c, o){ return new THREE.MeshStandardMaterial(Object.assign({color:c, roughness:.85, metalness:0}, o||{})); }
  function stripes(base, line, rx, ry){
    var c = document.createElement('canvas'); c.width=16; c.height=32;
    var x = c.getContext('2d');
    x.fillStyle=base; x.fillRect(0,0,16,32);
    x.fillStyle=line; for(var i=0;i<32;i+=4) x.fillRect(0,i,16,1);
    var t = new THREE.CanvasTexture(c);
    t.wrapS = t.wrapT = THREE.RepeatWrapping; t.repeat.set(rx,ry); t.anisotropy=4;
    return t;
  }
  function box(w,h,d,m,x,y,z,parent,cut){
    // cut-group meshes get their own material instance: shared materials would
    // overwrite each other's opacity and break the cutaway
    var g = new THREE.Mesh(new THREE.BoxGeometry(w,h,d), cut ? m.clone() : m);
    g.position.set(x,y,z); g.castShadow=true; g.receiveShadow=true;
    (parent||scene).add(g);
    if(cut){ g.userData.cut = cut; cutMeshes[cut].push(g); }
    return g;
  }

  // wall with real openings: bands around each opening so daylight enters
  // axis 'z' → wall in XY plane at given z; axis 'x' → wall in ZY plane at given x
  function punch(axis, at, thick, u0, u1, v0, v1, openings, m, parent, cut){
    openings = (openings||[]).slice().sort(function(a,b){ return a.u0-b.u0; });
    var segs = [], cur = u0;
    openings.forEach(function(o){
      if(o.u0 > cur) segs.push([cur, o.u0, v0, v1]);
      if(o.v0 > v0) segs.push([o.u0, o.u1, v0, o.v0]);
      if(o.v1 < v1) segs.push([o.u0, o.u1, o.v1, v1]);
      cur = o.u1;
    });
    if(cur < u1) segs.push([cur, u1, v0, v1]);
    segs.forEach(function(s){
      var w = s[1]-s[0], h = s[3]-s[2], cu = (s[0]+s[1])/2, cv = (s[2]+s[3])/2;
      if(w <= 0.001 || h <= 0.001) return;
      if(axis === 'z') box(w, h, thick, m, cu, cv, at, parent, cut);
      else box(thick, h, w, m, at, cv, cu, parent, cut);
    });
    // glass panes in the openings
    openings.forEach(function(o){
      var w = o.u1-o.u0, h = o.v1-o.v0, cu=(o.u0+o.u1)/2, cv=(o.v0+o.v1)/2;
      var g = new THREE.MeshStandardMaterial({color:0x223034, roughness:.08, metalness:.6,
        transparent:true, opacity:.42, emissive:new THREE.Color(0xf2b563), emissiveIntensity:0});
      var pane = (axis==='z')
        ? box(w, h, 0.05, g, cu, cv, at, parent)
        : box(0.05, h, w, g, at, cv, cu, parent);
      pane.castShadow = false;
      glassPanes.push(g); winGlow.push(g);
    });
  }

  function build(){
    scene = new THREE.Scene();
    scene.background = new THREE.Color(0xf3eee3);
    scene.fog = new THREE.Fog(0xf3eee3, 40, 110);
    camera = new THREE.PerspectiveCamera(mobile?66:52, innerWidth/innerHeight, 0.08, 400);

    hemi = new THREE.HemisphereLight(0xdce7f2, 0x74704f, .5); scene.add(hemi);
    amb  = new THREE.AmbientLight(0xefe7d6, .7); scene.add(amb);
    sun  = new THREE.DirectionalLight(0xffe8c8, 2.0);
    sun.position.set(-18,11,15); sun.castShadow = true;
    sun.shadow.mapSize.set(1024,1024);
    sun.shadow.camera.left=-30; sun.shadow.camera.right=30;
    sun.shadow.camera.top=30; sun.shadow.camera.bottom=-30; sun.shadow.camera.far=110;
    sun.shadow.bias = -0.0006;
    scene.add(sun);

    // ---- palette ----
    var larch    = mat(0xa78a63, {roughness:.86, map:stripes('#ad8f65','#93764c',3,16)});
    var larchTop = mat(0x6f5334, {roughness:.9});
    var fx       = mat(0x35322f, {roughness:.62});
    var fxTop    = mat(0x2a2725, {roughness:.7});
    var base     = mat(0x2b2825, {roughness:.95});
    var slab     = mat(0xe4ddce, {roughness:.92});
    var inner    = mat(0xf0eade, {roughness:.96});
    var innerW   = mat(0xe8e0d0, {roughness:.96});
    var deck     = mat(0xc0a077, {roughness:.8, map:stripes('#c3a37a','#a98a62',2,10)});

    // ---- terrain ----
    var ground = new THREE.Mesh(new THREE.PlaneGeometry(220,220), mat(0x77805d,{roughness:1}));
    ground.rotation.x = -Math.PI/2; ground.position.y = -0.62; ground.receiveShadow = true; scene.add(ground);
    var slopeM = new THREE.Mesh(new THREE.BoxGeometry(44,1.2,28), mat(0x6b7452,{roughness:1}));
    slopeM.position.set(0,-1.2,-2); slopeM.receiveShadow = true; scene.add(slopeM);

    // ---- house shell: wood volume (A) + dark wing (B) ----
    var t = 0.2;
    var Ax0=-7.2, Ax1=-0.2, Az0=-3.6, Az1=3.6, Ay1=6.6;   // wood, two storeys
    var Bx0=-0.2, Bx1=6.4,  By1=3.5;                       // dark wing, one storey

    // wood — south face (openings: 2 ground, 2 upper)
    punch('z', Az1-t/2, t, Ax0, Ax1, 0, Ay1, [
      {u0:-6.6,u1:-5.5,v0:1.0,v1:3.0}, {u0:-4.2,u1:-2.2,v0:0.9,v1:3.0},
      {u0:-6.6,u1:-5.6,v0:4.2,v1:6.0}, {u0:-4.0,u1:-2.4,v0:4.2,v1:6.0}
    ], larch, null, 'front');
    // wood — north face
    punch('z', Az0+t/2, t, Ax0, Ax1, 0, Ay1, [
      {u0:-5.2,u1:-4.2,v0:1.2,v1:2.6}, {u0:-3.0,u1:-2.0,v0:4.4,v1:5.8}
    ], larch, null, 'other');
    // wood — west face (corner window upstairs)
    punch('x', Ax0+t/2, t, Az0, Az1, 0, Ay1, [
      {u0:0.2,u1:2.2,v0:4.2,v1:6.0}
    ], larch, null, 'other');
    // wood roof
    box(7.5,0.14,7.7, larchTop, (Ax0+Ax1)/2, Ay1+0.07, 0, null, 'roof');

    // cantilever volume over the entrance (wood, oversails the dark wing)
    punch('z', Az1-t/2, t, Bx0, 2.2, By1, Ay1, [{u0:0.3,u1:1.7,v0:4.3,v1:6.0}], larch, null, 'front');
    punch('z', Az0+t/2, t, Bx0, 2.2, By1, Ay1, [], larch, null, 'other');
    punch('x', 2.2-t/2, t, Az0, Az1, By1, Ay1, [], larch, null, 'other');
    box(2.4,0.16,7.2, larchTop, 1.0, By1+0.05, 0, null, 'roof');   // soffit
    box(2.7,0.14,7.7, larchTop, 1.0, Ay1+0.07, 0, null, 'roof');   // roof over cantilever

    // entrance recess: glazed front under the cantilever
    punch('z', Az1-t/2, t, Bx0, 2.2, 0, By1, [{u0:0.1,u1:1.9,v0:0.05,v1:2.7}], fx, null, 'front');

    // dark wing — south (big terrace glazing), east, north
    punch('z', Az1-t/2, t, 2.2, Bx1, 0, By1, [{u0:2.7,u1:5.2,v0:0.1,v1:2.7}], fx, null, 'front');
    punch('x', Bx1-t/2, t, Az0, Az1, 0, By1, [{u0:-2.4,u1:-0.6,v0:1.0,v1:2.6}], fx, null, 'other');
    punch('z', Az0+t/2, t, Bx0, Bx1, 0, By1, [{u0:1.4,u1:2.8,v0:1.1,v1:2.5}], fx, null, 'other');
    box(6.9,0.14,7.7, fxTop, (Bx0+Bx1)/2, By1+0.07, 0, null, 'roof');

    // foundation + chimney
    box(14.2,0.62,7.9, base, -0.4,-0.31,0);
    box(0.55,1.5,0.55, slab, -2.6, 7.3, -1.7, null, 'other');

    // ---- interior ----
    box(13.6,0.16,7.2, deck, -0.4, 0.08, 0);                 // ground floor
    box(6.9,0.18,7.0, slab, -3.7, 3.52, 0, null, 'roof');    // upper floor slab (hidden with roof)
    box(0.16,3.4,4.6, inner, -0.3, 1.7, -1.0);               // partition: living / kitchen
    box(3.6,3.4,0.16, innerW, 2.6, 1.7, -1.2);               // partition: kitchen / utility
    box(13.6,3.4,0.14, innerW, -0.4, 1.7, -3.42);            // inner face of back wall
    box(0.14,3.4,7.0, innerW, -7.02, 1.7, 0);                // inner face of west wall

    // fireplace + fire
    box(1.05,1.45,0.75, mat(0x2b2825), -6.1, 0.82, -1.4);
    box(0.62,0.5,0.08, new THREE.MeshStandardMaterial({color:0xff9a3c, emissive:0xff7b1a, emissiveIntensity:2.4}), -5.62, 0.85, -1.4);
    firelight = new THREE.PointLight(0xff8c3a, 0, 8, 2); firelight.position.set(-5.3,1.15,-1.3); scene.add(firelight);

    box(0.14,3.4,3.0, innerW, -4.6, 1.7, -2.0);              // partition: living / bathroom
    box(2.4,3.4,0.14, innerW, -5.9, 1.7, -0.5);              // partition: bathroom front
    box(0.9,0.6,0.7, mat(0xe9e6de), -6.6, 0.38, -2.6);       // bath fixture
    box(3.4,0.02,2.4, mat(0x8e8a76), -4.6, 0.18, 1.2);       // rug
    // furniture blocks
    box(2.4,0.7,0.95, mat(0x6e6a5e), -4.4, 0.44, 1.5);       // sofa
    box(1.3,0.34,0.7, mat(0xa8845a), -4.4, 0.26, 0.45);      // coffee table
    for(var i=0;i<9;i++) box(1.1,0.18,0.28, slab, -1.0, 0.22+i*0.37, 2.5-i*0.3); // stairs
    box(3.0,0.9,0.62, mat(0xd3d3c8), 3.4, 0.53, -2.9);       // kitchen counter
    box(1.8,0.74,0.9, mat(0xa8845a), 3.6, 0.45, 0.6);        // dining table
    box(1.9,0.5,2.0, mat(0xe3dbcb), -5.1, 3.87, -1.4);       // bed upstairs

    // room lights (so interiors read; they ramp up on interior beats)
    [[-4.6,2.3,0.2],[3.2,2.3,-1.0],[-4.6,4.9,-0.6]].forEach(function(p){
      var l = new THREE.PointLight(0xfff0d8, 0, 11, 2);
      l.position.set(p[0],p[1],p[2]); scene.add(l); roomLights.push(l);
    });

    // ---- terrace, altánok, trees ----
    box(5.6,0.16,3.2, deck, 3.6, -0.02, 5.2);
    for(var k=0;k<3;k++) box(0.14,2.4,0.14, larchTop, 1.6+k*2.1, 1.14, 6.6);
    box(5.6,0.14,0.14, larchTop, 3.6, 2.32, 6.6);
    box(2.6,2.1,2.6, larch, 12.2, 0.42, 5.6);
    box(3.1,0.16,3.1, larchTop, 12.2, 1.55, 5.6);
    function tree(x,z,s){
      box(0.28,2.2*s,0.28, mat(0x6b543a), x, 1.1*s-0.6, z);
      var c = new THREE.Mesh(new THREE.IcosahedronGeometry(1.5*s,0), mat(0x56693f,{flatShading:true}));
      c.position.set(x, 2.6*s, z); c.castShadow = true; scene.add(c);
    }
    tree(-14,7,1.35); tree(-11,-9,1.1); tree(16,-7,1.2); tree(20,8,1.0); tree(-19,-3,.9); tree(9,-10,1.05);

    // ---- wall section exhibit (beat 05): stands on the lawn, clean background ----
    var defs = [
      {c:0xb08c5c,t:0.10,m:stripes('#b78f5c','#9a7444',1,10)}, {c:0xe6dbc6,t:0.06},
      {c:0xc9ad7c,t:0.08}, {c:0xdfd4bd,t:0.34}, {c:0xcbb894,t:0.03},
      {c:0xece3d2,t:0.10}, {c:0xf7f3e9,t:0.04}
    ];
    var lx = -13.9;
    defs.forEach(function(d,i){
      var m = mat(d.c, d.m ? {roughness:.9, map:d.m} : {roughness:.9});
      var mesh = box(d.t, 2.5, 2.3, m, lx + d.t/2, 1.25, 8.3);
      mesh.userData.baseX = lx + d.t/2;
      layerMeshes.push(mesh);
      lx += d.t;
    });

    renderer = new THREE.WebGLRenderer({antialias:true, powerPreference:'high-performance'});
    renderer.setPixelRatio(Math.min(devicePixelRatio, 2));
    renderer.setSize(innerWidth, innerHeight);
    renderer.shadowMap.enabled = true;
    renderer.shadowMap.type = THREE.PCFSoftShadowMap;
    renderer.outputColorSpace = THREE.SRGBColorSpace;
    renderer.toneMapping = THREE.ACESFilmicToneMapping;
    renderer.toneMappingExposure = 0.98;
    document.getElementById('world').appendChild(renderer.domElement);
    ready = true;
  }

  // ---------------- scroll → world ----------------
  var vA=new THREE.Vector3(), vB=new THREE.Vector3(), tA=new THREE.Vector3(), tB=new THREE.Vector3(), look=new THREE.Vector3();
  var cSun=new THREE.Color(), cAmb=new THREE.Color(), cBg=new THREE.Color();
  function ease(t){ return t<0.5 ? 4*t*t*t : 1-Math.pow(-2*t+2,3)/2; }
  function lerp(a,b,t){ return a+(b-a)*t; }
  function fade(list, op){
    for(var i=0;i<list.length;i++){
      var m = list[i].material;
      m.transparent = op < 0.995;
      m.opacity = op;
      m.depthWrite = op > 0.55;
      list[i].castShadow = op > 0.55;
      list[i].visible = op > 0.012;
    }
  }

  function apply(p){
    var n = BEATS.length-1;
    var f = Math.max(0, Math.min(n, p*n));
    var i = Math.min(n-1, Math.floor(f));
    var t = ease(f-i), a = BEATS[i], b = BEATS[i+1];

    vA.fromArray(a.pos); vB.fromArray(b.pos);
    tA.fromArray(a.tgt); tB.fromArray(b.tgt);
    camera.position.lerpVectors(vA, vB, t);
    look.lerpVectors(tA, tB, t);
    camera.lookAt(look);

    fade(cutMeshes.front, lerp(a.cut[0], b.cut[0], t));
    fade(cutMeshes.roof,  lerp(a.cut[1], b.cut[1], t));
    fade(cutMeshes.other, lerp(a.cut[2], b.cut[2], t));

    var sa = SUN[a.sun], sb = SUN[b.sun];
    sun.intensity = lerp(sa.int, sb.int, t);
    cSun.set(sa.col).lerp(new THREE.Color(sb.col), t); sun.color.copy(cSun);
    sun.position.set(lerp(sa.pos[0],sb.pos[0],t), lerp(sa.pos[1],sb.pos[1],t), lerp(sa.pos[2],sb.pos[2],t));
    amb.intensity = lerp(sa.ambInt, sb.ambInt, t);
    cAmb.set(sa.amb).lerp(new THREE.Color(sb.amb), t); amb.color.copy(cAmb);
    cBg.set(sa.bg).lerp(new THREE.Color(sb.bg), t); scene.background.copy(cBg); scene.fog.color.copy(cBg);
    hemi.intensity = lerp(a.sun==='dusk'?.1:.5, b.sun==='dusk'?.1:.5, t);

    var dusk = Math.max(0, Math.min(1, f-7));
    var indoors = Math.max(0, Math.min(1, 1 - Math.min(Math.abs(f-3), Math.abs(f-6))/1.4));
    roomLights.forEach(function(l){ l.intensity = indoors*3.2 + dusk*6; });
    firelight.intensity = Math.max(0, 1-Math.abs(f-3)) * 3.2 + dusk*0.8;
    winGlow.forEach(function(m){ m.emissiveIntensity = dusk*1.6; m.opacity = 0.42; });

    var ex = Math.max(0, 1 - Math.abs(f-4)*1.1);
    layerMeshes.forEach(function(m, idx){
      m.position.x = m.userData.baseX - ex * (idx-3) * 0.46;
      m.visible = f > 2.6 && f < 5.6;
    });

    document.body.classList.toggle('dusk', f > 7.35);
    var idx = Math.round(f);
    if(mapLabel.textContent !== BEATS[idx].name) mapLabel.textContent = BEATS[idx].name;
    for(var d=0; d<dotEls.length; d++) dotEls[d].classList.toggle('on', d===idx);
    hint.style.opacity = p > 0.02 ? 0 : 1;
  }

  var mapLabel = document.getElementById('mapLabel');
  var dotsWrap = document.getElementById('dots'), dotEls = [];
  BEATS.forEach(function(){ var e=document.createElement('i'); dotsWrap.appendChild(e); dotEls.push(e); });
  var hint = document.getElementById('hint');

  function render(){ if(ready) renderer.render(scene, camera); requestAnimationFrame(render); }
  function onResize(){
    if(!ready) return;
    mobile = innerWidth < 861;
    camera.aspect = innerWidth/innerHeight; camera.fov = mobile?66:52;
    camera.updateProjectionMatrix();
    renderer.setSize(innerWidth, innerHeight);
  }

  function start(){
    build(); apply(0); render();
    addEventListener('resize', onResize);
    gsap.registerPlugin(ScrollTrigger);

    ScrollTrigger.create({
      trigger:'#scroller', start:'top top', end:'bottom bottom',
      onUpdate: function(self){ apply(self.progress); }
    });
    gsap.utils.toArray('.panel').forEach(function(el){
      gsap.timeline({scrollTrigger:{trigger: el.parentElement, start:'top 78%', end:'bottom 22%', scrub: reduce?false:0.4}})
        .fromTo(el, {opacity:0, y:reduce?0:18}, {opacity:1, y:0, duration:.28, ease:'power2.out'})
        .to(el, {opacity:1, duration:.44})
        .to(el, {opacity:reduce?1:0, y:reduce?0:-14, duration:.28, ease:'power2.in'});
    });

    // review hook: ?beat=N renders one held shot (static-frame test)
    var mb = location.search.match(/[?&]beat=([0-9.]+)/);
    if(mb){
      var bi = parseFloat(mb[1]), r = Math.round(bi);
      ScrollTrigger.getAll().forEach(function(s){ s.kill(); });
      apply(bi/(BEATS.length-1));
      gsap.set('.panel', {opacity:0, y:0});
      document.querySelectorAll('.beat').forEach(function(s,ix){
        if(ix===r){ s.style.position='fixed'; s.style.inset='0'; gsap.set(s.querySelector('.panel'), {opacity:1,y:0}); }
        else s.style.display='none';
      });
    }

    document.getElementById('bar').style.width = '100%';
    setTimeout(function(){ document.getElementById('load').classList.add('gone'); }, 520);
  }

  if(window.THREE && window.gsap) start(); else addEventListener('load', start);
})();
</script>
</body>
</html>
